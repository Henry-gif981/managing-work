  "dependencies": {
    "three": "^0.169.0"
  },
  "scripts": {
    "content": "pdftotext -layout \"paper/IBRD - NH\u00d3M 6(1).pdf\" content/raw.txt && python3 scripts/extract_content.py && node scripts/build-content.mjs && node scripts/make-docs.mjs",
    "assets": "node scripts/copy-fonts.mjs && python3 scripts/make-textures.py && node scripts/make-vietnam.mjs",
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && node scripts/make-docs.mjs && vite build",
    "start": "npm run build && vite preview --open",
    "fallbacks": "node scripts/render-fallbacks.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "check": "node scripts/verify-content.mjs && node scripts/check-links.mjs && node scripts/audit-fonts.mjs",
    "qa": "node scripts/qa.mjs",
    "perf": "node scripts/perf.mjs",
    "standalone": "node scripts/build-standalone.mjs"
  }
}
