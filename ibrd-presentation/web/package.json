    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-serif": "^2.0.0",
    "js-yaml": "^4.1.0",
    "lighthouse": "^12.2.1",
    "topojson-client": "^3.1.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "world-atlas": "^2.0.2"
